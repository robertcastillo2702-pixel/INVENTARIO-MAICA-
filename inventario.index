        <h3>Filtros</h3>
        <div class="grid-form">
          <div class="field">
            <label>Número de Parte</label>
            <div class="input-prefix-group">
              <span class="input-prefix">EPV-</span>
              <input type="text" id="graParteSuffix" list="dl-partes-suffix" placeholder="1001" autocomplete="off" required>

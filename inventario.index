        <div style="overflow-x:auto; margin-top:14px;">
          <table>
            <thead><tr><th>Fecha</th><th>Tipo</th><th>N° de Parte</th><th class="col-center">Cantidad</th><th class="col-center">Sobremedida</th><th>Observación</th></tr></thead>
            <tbody id="repTableBody"></tbody>

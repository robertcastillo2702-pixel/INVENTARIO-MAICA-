<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manufacturas de Aluminio I C.A. — Sistema de Inventario</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" defer></script>
<style>
  :root{
    --graphite-900:#111111;
    --graphite-800:#1a1a1a;
    --graphite-700:#2e2e2e;
    --steel-500:#6b6b6b;
    --steel-300:#a8a8a8;
    --steel-200:#dcdcdc;
    --aluminum-100:#f2f2f2;
    --aluminum-50:#fafafa;
    --white:#ffffff;
    --accent:#e11b1b;
    --accent-dark:#b01212;
    --blue:#2e2e2e;
    --blue-dark:#111111;
    --green:#1f8a3b;
    --red:#e11b1b;
    --radius:10px;
    --shadow:0 1px 3px rgba(17,17,17,.08), 0 1px 2px rgba(17,17,17,.06);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:var(--aluminum-100);
    color:var(--graphite-900);
    background-image:
      linear-gradient(var(--aluminum-100) 1px, transparent 1px),
      linear-gradient(90deg, var(--aluminum-100) 1px, transparent 1px);
  }
  h1,h2,h3{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; font-weight:700; letter-spacing:.01em; margin:0;}
  .mono{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;}
  button{font-family:inherit; cursor:pointer;}
  input, select{font-family:inherit;}
  ::selection{background:var(--accent); color:white;}

  /* ---------- LOGIN ---------- */
  #login-screen{
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    background:
      repeating-linear-gradient(135deg, #1c2126 0px, #1c2126 2px, #20262b 2px, #20262b 40px);
    padding:20px;
  }
  .login-card{
    width:100%; max-width:380px; background:var(--white); border-radius:var(--radius);
    box-shadow:0 20px 60px rgba(0,0,0,.35); overflow:hidden;
  }
  .login-brand{
    background:var(--graphite-900); color:white; padding:28px 28px 22px;
    position:relative; overflow:hidden;
  }
  .login-brand .ticks{
    position:absolute; left:0; right:0; bottom:0; height:8px;
    background-image:repeating-linear-gradient(90deg, var(--accent) 0 2px, transparent 2px 14px);
    opacity:.9;
  }
  .login-brand .eyebrow{
    font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace; font-size:11px; letter-spacing:.14em;
    color:var(--accent); text-transform:uppercase; margin-bottom:6px;
  }
  .login-brand h1{font-size:19px; line-height:1.3; color:white; text-align:center; margin-top:2px;}
  .login-brand p{margin:6px 0 0; font-size:12.5px; color:var(--steel-300); text-align:center;}
  .login-logo{display:block; height:100px; width:auto; margin:0 auto 14px; border-radius:6px; background:white; padding:4px; object-fit:contain; object-position:center;}
  .login-body{padding:26px 28px 30px;}
  .field{margin-bottom:16px;}
  .field label{display:block; font-size:12px; font-weight:600; color:var(--graphite-700); margin-bottom:6px; text-transform:uppercase; letter-spacing:.04em;}
  .field input{
    width:100%; padding:11px 12px; border:1.5px solid var(--steel-200); border-radius:7px;
    font-size:14.5px; outline:none; transition:border-color .15s;
  }
  .field input:focus{border-color:var(--accent);}
  .btn{
    border:none; border-radius:7px; padding:11px 18px; font-size:14px; font-weight:600;
    display:inline-flex; align-items:center; justify-content:center; gap:8px; transition:filter .15s, transform .05s;
  }
  .btn:active{transform:translateY(1px);}
  .btn-primary{background:var(--accent); color:white; width:100%;}
  .btn-primary:hover{filter:brightness(1.06);}
  .btn-secondary{background:var(--aluminum-100); color:var(--graphite-800); border:1.5px solid var(--steel-200);}
  .btn-secondary:hover{background:var(--steel-200);}
  .btn-blue{background:var(--blue); color:white;}
  .btn-blue:hover{filter:brightness(1.08);}
  .btn-danger-outline{background:transparent; color:var(--red); border:1.5px solid #f0c4c4; padding:7px 10px; font-size:12.5px;}
  .btn-danger-outline:hover{background:#fdf0f0;}
  .btn-ghost-outline{background:transparent; color:var(--graphite-700); border:1.5px solid var(--steel-200); padding:7px 10px; font-size:12.5px;}
  .btn-ghost-outline:hover{background:var(--aluminum-100);}
  .btn-sm{padding:8px 12px; font-size:13px;}
  .login-error{
    background:#fdf0f0; border:1px solid #f0c4c4; color:var(--red); font-size:13px;
    padding:9px 11px; border-radius:7px; margin-bottom:14px; display:none;
  }
  .auth-switch{text-align:center; font-size:12.5px; color:var(--steel-500); margin:16px 0 0;}
  .auth-switch a{color:var(--accent-dark); font-weight:600; text-decoration:none;}
  .auth-switch a:hover{text-decoration:underline;}
  .auth-switch-inline{font-size:12px; color:var(--accent-dark); font-weight:600; text-decoration:none;}
  .auth-switch-inline:hover{text-decoration:underline;}
  .profile-hint{font-size:13px; color:var(--steel-500); text-align:center; margin:0 0 16px;}
  .profile-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(84px,1fr)); gap:12px;}
  .profile-card{
    display:flex; flex-direction:column; align-items:center; gap:6px; padding:14px 8px;
    border:1.5px solid var(--steel-200); border-radius:10px; cursor:pointer; background:var(--aluminum-50);
    transition:.12s; position:relative;
  }
  .profile-card:hover{border-color:var(--accent); background:#fff5f5;}
  .profile-delete-btn{
    position:absolute; top:-6px; right:-6px; width:20px; height:20px; border-radius:50%;
    background:var(--red); color:white; border:2px solid white; font-size:13px; line-height:1;
    display:flex; align-items:center; justify-content:center; cursor:pointer; padding:0; z-index:2;
    box-shadow:0 2px 4px rgba(0,0,0,.2);
  }
  .profile-delete-btn:hover{filter:brightness(1.1); transform:scale(1.1);}
  .profile-avatar{
    width:40px; height:40px; border-radius:50%; background:var(--graphite-900); color:white;
    display:flex; align-items:center; justify-content:center; font-weight:700; font-size:16px; flex-shrink:0;
  }
  .profile-name{font-size:12.5px; font-weight:600; color:var(--graphite-900); text-align:center; line-height:1.2; word-break:break-word;}
  .profile-role{font-size:10.5px; color:var(--steel-500); text-transform:uppercase; letter-spacing:.03em;}
  .profile-card-new{background:var(--white); border-style:dashed;}
  .profile-avatar-new{background:var(--aluminum-100); color:var(--accent); font-size:22px;}
  .profile-selected{display:flex; align-items:center; gap:12px; margin-bottom:18px;}
  .profile-selected .profile-avatar{width:46px; height:46px; font-size:18px;}
  .profile-selected-name{font-weight:700; font-size:15px; color:var(--graphite-900); margin-bottom:2px;}
  .role-options{display:flex; gap:14px; margin-top:2px;}
  .role-option{display:flex; align-items:center; gap:6px; font-size:13.5px; color:var(--graphite-700); font-weight:500; cursor:pointer;}
  .role-option input{width:auto; margin:0;}

  /* ---------- APP SHELL ---------- */
  #app{display:none; min-height:100vh; grid-template-columns:240px 1fr auto;}
  #app.active{display:grid;}
  .brand-panel{
    width:240px; min-height:100vh; background:var(--graphite-900); position:relative; overflow:hidden;
    background-image:
      repeating-linear-gradient(135deg, var(--accent) 0px, var(--accent) 26px, transparent 26px, transparent 52px),
      repeating-linear-gradient(135deg, #000 0px, #000 26px, var(--graphite-900) 26px, var(--graphite-900) 52px);
    background-blend-mode:normal;
    opacity:1;
  }
  .brand-panel::before{
    content:''; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(17,17,17,.15) 0%, rgba(17,17,17,.75) 75%, rgba(17,17,17,.92) 100%);
  }
  .brand-panel .brand-panel-content{
    position:absolute; left:0; right:0; bottom:0; padding:32px 18px; text-align:center; z-index:2;
  }
  .brand-panel .brand-panel-content img{display:block; height:130px; width:auto; max-width:190px; margin:0 auto 18px; border-radius:12px; background:white; padding:10px; box-shadow:0 8px 24px rgba(0,0,0,.35); object-fit:contain;}
  .brand-panel .brand-panel-content p{color:white; font-size:16px; font-weight:700; line-height:1.35; letter-spacing:.01em; margin:0;}
  .sidebar{
    background:var(--graphite-900); color:white; padding:22px 0 16px; display:flex; flex-direction:column;
    position:sticky; top:0; height:100vh;
  }
  .sidebar-brand{padding:0 20px 20px; border-bottom:1px solid var(--graphite-700); margin-bottom:14px; text-align:center;}
  .sidebar-logo{display:block; height:48px; width:auto; margin:0 auto 12px; border-radius:6px; background:white; padding:4px; object-fit:contain;}
  .sidebar-brand .eyebrow{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace; font-size:12px; font-weight:700; color:var(--accent); letter-spacing:.08em; text-transform:uppercase; margin-top:8px;}
  .sidebar-brand h1{font-size:14.5px; color:white; margin-top:0; line-height:1.35; white-space:normal; overflow:visible; font-weight:700; text-align:center;}
  .nav-item{
    display:flex; align-items:center; gap:12px; padding:12px 20px; color:var(--steel-300);
    font-size:14px; font-weight:500; cursor:pointer; border-left:3px solid transparent; transition:.12s;
  }
  .nav-item svg{width:18px; height:18px; flex-shrink:0;}
  .nav-item:hover{background:var(--graphite-800); color:white;}
  .nav-item.active{background:var(--graphite-800); color:white; border-left-color:var(--accent);}
  .sidebar-footer{margin-top:auto; padding:16px 20px 0; border-top:1px solid var(--graphite-700);}
  .sidebar-user{font-size:12.5px; color:var(--steel-300); margin-bottom:10px;}
  .sidebar-user strong{display:block; color:white; font-size:13.5px; margin-bottom:3px; word-break:break-word;}

  .main{padding:28px 34px 60px; max-width:1300px;}
  .topbar{display:flex; justify-content:flex-end; margin-bottom:18px;}
  .topbar-user-wrap{position:relative;}
  .topbar-user{display:flex; align-items:center; gap:9px; background:var(--white); border:1px solid var(--steel-200); border-radius:30px; padding:6px 12px 6px 6px; box-shadow:var(--shadow); cursor:pointer; max-width:260px;}
  .topbar-avatar{width:28px; height:28px; border-radius:50%; background:var(--graphite-900); color:white; display:flex; align-items:center; justify-content:center; font-size:12.5px; font-weight:700; flex-shrink:0;}
  .topbar-user span{font-size:13.5px; font-weight:600; color:var(--graphite-900); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:150px;}
  .topbar-user svg{color:var(--steel-500); flex-shrink:0;}

  .profile-dropdown{
    display:none; position:absolute; top:calc(100% + 10px); right:0; width:340px; background:white;
    border:1px solid var(--steel-200); border-radius:14px; box-shadow:0 20px 48px rgba(17,17,17,.2); padding:22px; z-index:60;
  }
  .profile-dropdown.active{display:block;}
  .profile-dropdown-section{margin-bottom:20px;}
  .profile-dropdown-section:last-child{margin-bottom:0;}
  .profile-dropdown-label{display:block; font-size:11.5px; font-weight:700; color:var(--steel-500); text-transform:uppercase; letter-spacing:.05em; margin-bottom:9px;}
  .profile-dropdown-input{
    display:block; width:100%; padding:11px 13px; border:2px solid var(--steel-200); border-radius:8px;
    font-size:14.5px; outline:none; background:var(--white); color:var(--graphite-900);
  }
  .profile-dropdown-input:focus{border-color:var(--accent);}
  .theme-swatches{display:flex; gap:10px; flex-wrap:wrap;}
  .theme-swatch{width:34px; height:34px; border-radius:50%; cursor:pointer; border:3px solid transparent; box-shadow:0 0 0 1px var(--steel-200); transition:.12s; flex-shrink:0;}
  .theme-swatch:hover{transform:scale(1.1);}
  .theme-swatch.selected{border-color:var(--graphite-900);}
  .main-header{display:flex; align-items:baseline; justify-content:space-between; margin-bottom:22px; flex-wrap:wrap; gap:8px;}
  .main-header .eyebrow{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace; font-size:11px; color:var(--accent); letter-spacing:.12em; text-transform:uppercase; display:block; margin-bottom:4px;}
  .main-header h2{font-size:26px; color:var(--graphite-900);}

  .card{background:var(--white); border:1px solid var(--steel-200); border-radius:var(--radius); box-shadow:var(--shadow); padding:22px 24px; margin-bottom:22px;}
  .card h3{font-size:15px; color:var(--graphite-800); margin-bottom:16px; padding-bottom:10px; border-bottom:1px solid var(--aluminum-100);}

  .grid-form{display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; align-items:end;}
  .grid-form .field{margin-bottom:0;}
  .grid-form .field input, .grid-form .field select{width:100%; padding:10px 11px; border:1.5px solid var(--steel-200); border-radius:7px; font-size:14px; outline:none;}
  .grid-form .field input:focus, .grid-form .field select:focus{border-color:var(--accent);}

  .input-prefix-group{display:flex; align-items:stretch;}
  .input-prefix-group .input-prefix{
    background:var(--graphite-900); color:white; padding:0 10px; display:flex; align-items:center;
    font-weight:700; font-size:13.5px; border-radius:7px 0 0 7px; font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
    letter-spacing:.02em; flex-shrink:0;
  }
  .input-prefix-group input{border-radius:0 7px 7px 0 !important; border-left:none !important; flex:1; min-width:0;}
  .input-prefix-group input:focus{border-color:var(--accent) !important;}
  .grid-form .field label{display:block; font-size:11.5px; font-weight:600; color:var(--steel-500); margin-bottom:6px; text-transform:uppercase; letter-spacing:.04em;}

  .search-row{display:flex; gap:10px; margin-bottom:14px; align-items:center;}
  .search-row input[type=search]{flex:1; padding:10px 14px; border:1.5px solid var(--steel-200); border-radius:7px; font-size:14px; outline:none;}
  .search-row input[type=search]:focus{border-color:var(--accent);}

  table{width:100%; border-collapse:collapse; font-size:13.5px;}
  .col-center{text-align:center;}
  thead th{
    background:var(--graphite-900); color:white; text-align:left; padding:10px 12px; font-size:11px;
    text-transform:uppercase; letter-spacing:.06em; font-weight:600;
  }
  thead th:first-child{border-top-left-radius:6px;}
  thead th:last-child{border-top-right-radius:6px;}
  tbody td{padding:10px 12px; border-bottom:1px solid var(--aluminum-100);}
  tbody tr:nth-child(even){background:var(--aluminum-50);}
  tbody tr:hover{background:#fff2ea;}
  .tag{display:inline-block; padding:3px 9px; border-radius:20px; font-size:11px; font-weight:700; letter-spacing:.03em;}
  .tag-entrada{background:#e6f4ea; color:var(--green);}
  .tag-salida{background:#e9e9e9; color:var(--graphite-900);}
  .empty-state{text-align:center; padding:36px 20px; color:var(--steel-500); font-size:14px;}
  .row-actions{display:flex; gap:6px;}

  .kpi-row{display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin-bottom:22px;}
  .kpi{background:var(--white); border:1px solid var(--steel-200); border-radius:var(--radius); padding:16px 18px; box-shadow:var(--shadow);}
  .kpi .eyebrow{font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace; font-size:10.5px; color:var(--steel-500); text-transform:uppercase; letter-spacing:.08em;}
  .kpi .value{font-family:inherit; font-weight:700; font-size:26px; margin-top:4px;}
  .kpi.entrada .value{color:var(--green);}
  .kpi.salida .value{color:var(--graphite-900);}
  .kpi.saldo .value{color:var(--accent);}

  .modal-overlay{
    display:none; position:fixed; inset:0; background:rgba(24,28,32,.55); z-index:100;
    align-items:center; justify-content:center; padding:20px;
  }
  .modal-overlay.active{display:flex;}
  .modal{background:white; border-radius:var(--radius); width:100%; max-width:420px; padding:24px; box-shadow:0 24px 60px rgba(0,0,0,.3);}
  .modal h3{font-size:16px; margin-bottom:16px;}
  .modal-actions{display:flex; gap:10px; margin-top:18px;}
  .modal-actions .btn{flex:1;}

  .chart-wrap{background:white; border-radius:8px; padding:10px 6px;}
  #chartMsg{font-size:14px; color:var(--graphite-700); margin-top:14px; padding:12px 14px; background:var(--aluminum-50); border-left:3px solid var(--accent); border-radius:6px;}

  .toast{
    position:fixed; bottom:24px; right:24px; background:var(--graphite-900); color:white; padding:12px 18px;
    border-radius:8px; font-size:13.5px; box-shadow:0 10px 30px rgba(0,0,0,.3); z-index:200;
    opacity:0; transform:translateY(10px); transition:.2s; pointer-events:none;
  }
  .toast.show{opacity:1; transform:translateY(0);}

  .loading-note{font-size:13px; color:var(--steel-500); padding:6px 0;}

  @media (max-width:1200px){
    #app{grid-template-columns:240px 1fr;}
    .brand-panel{display:none;}
  }
  @media (max-width:820px){
    #app.active{display:block;}
    .sidebar{position:sticky; top:0; height:auto; width:100%; flex-direction:row; overflow-x:auto; padding:10px 0; z-index:50;}
    .sidebar-brand{display:none;}
    .nav-item{border-left:none; border-bottom:3px solid transparent; padding:10px 16px; white-space:nowrap;}
    .nav-item.active{border-bottom-color:var(--accent);}
    .sidebar-footer{display:none;}
    .main{padding:20px 16px 40px;}
    .grid-form{grid-template-columns:1fr 1fr;}
  }
</style>
</head>
<body>

<!-- ============ LOGIN ============ -->
<div id="login-screen">
  <div class="login-card">
    <div class="login-brand">
      <img src="data:image/png;base64," alt="Manufacturas de Aluminio I C.A." class="login-logo">
      <h1>Manufacturas de Aluminio I C.A.</h1>
      <div class="ticks"></div>
    </div>
    <div class="login-body">

      <!-- ---- SELECCION DE PERFIL ---- -->
      <div id="profileSelectWrap">
        <p class="profile-hint">Selecciona tu usuario para ingresar</p>
        <div class="profile-grid" id="profileGrid"></div>
      </div>

      <!-- ---- INGRESAR CONTRASEÑA DEL PERFIL ---- -->
      <div id="passwordFormWrap" style="display:none;">
        <div class="profile-selected">
          <div class="profile-avatar" id="passwordFormAvatar">?</div>
          <div>
            <div class="profile-selected-name" id="passwordFormName">—</div>
            <a href="#" id="backToProfilesLink" class="auth-switch-inline">Elegir Otro Usuario</a>
          </div>
        </div>
        <div class="login-error" id="loginError">Contraseña incorrecta.</div>
        <form id="loginForm">
          <div class="field">
            <label for="loginPass">Contraseña</label>
            <input type="password" id="loginPass" autocomplete="current-password" placeholder="••••••">
          </div>
          <button type="submit" class="btn btn-primary">Entrar</button>
        </form>
      </div>

      <!-- ---- CREAR CUENTA ---- -->
      <div id="registerFormWrap" style="display:none;">
        <div class="login-error" id="registerError">Este usuario ya existe.</div>
        <form id="registerForm">
          <div class="field">
            <label for="regNombre">Nombre Completo</label>
            <input type="text" id="regNombre" autocomplete="off" placeholder="Tu nombre" required>
          </div>
          <div class="field">
            <label for="regPassword">Contraseña</label>
            <input type="password" id="regPassword" autocomplete="new-password" placeholder="••••••" required>
          </div>
          <div class="field">
            <label>Tipo de Usuario</label>
            <div class="role-options">
              <label class="role-option">
                <input type="radio" name="regRole" value="normal" checked> Usuario normal
              </label>
              <label class="role-option">
                <input type="radio" name="regRole" value="admin"> Administrador
              </label>
            </div>
          </div>
          <div class="field" id="regAdminCodeField" style="display:none;">
            <label for="regAdminCode">Clave de Administrador</label>
            <input type="password" id="regAdminCode" autocomplete="off" placeholder="Clave especial">
          </div>
          <button type="submit" class="btn btn-primary">Crear Cuenta</button>
        </form>
        <p class="auth-switch">¿Ya tienes cuenta? <a href="#" id="showLoginLink">Volver</a></p>
      </div>

    </div>
  </div>
</div>

<!-- ============ APP ============ -->
<div id="app">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <img src="data:image/png;base64," alt="Manufacturas de Aluminio I C.A." class="sidebar-logo">
      <h1>Manufacturas de<br>Aluminio I C.A.</h1>
      <div class="eyebrow">Sistema de Inventario</div>
    </div>
    <nav>
      <div class="nav-item active" data-module="catalogo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        Números de Parte
      </div>
      <div class="nav-item" data-module="entrada">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        Entrada
      </div>
      <div class="nav-item" data-module="salida">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        Salida
      </div>
      <div class="nav-item" data-module="graficas">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        Gráficas
      </div>
      <div class="nav-item" data-module="reportes">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19h16M7 16V9m5 7V5m5 11v-5"/></svg>
        Reportes
      </div>
    </nav>
    <div class="sidebar-footer">
      <div class="sidebar-user"><strong id="sidebarUserName">—</strong><span id="sidebarUserRole">—</span></div>
      <button class="btn btn-secondary btn-sm" id="logoutBtn" style="width:100%;">Cerrar Sesión</button>
    </div>
  </aside>

  <main class="main">

    <div class="topbar">
      <div class="topbar-user-wrap">
        <button class="topbar-user" id="topbarUserBtn" type="button">
          <div class="topbar-avatar" id="topbarUserAvatar">?</div>
          <span id="topbarUserName">—</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="profile-dropdown" id="profileDropdown">
          <div class="profile-dropdown-section">
            <label class="profile-dropdown-label">Nombre de usuario</label>
            <input type="text" id="perfilNombreInput" class="profile-dropdown-input" autocomplete="off" placeholder="Escribe tu nombre">
            <button class="btn btn-primary btn-sm" id="perfilGuardarNombreBtn" style="width:100%; margin-top:8px;">Guardar Nombre</button>
          </div>
          <div class="profile-dropdown-section">
            <label class="profile-dropdown-label">Apariencia</label>
            <div class="theme-swatches" id="themeSwatches"></div>
          </div>
          <div class="profile-dropdown-section" id="verCodigoSection" style="display:none;">
            <button class="btn btn-secondary btn-sm" id="verCodigoBtn" style="width:100%;">Ver Código Fuente del Sistema</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== MODULO CATALOGO ===== -->
    <section id="module-catalogo" class="module">
      <div class="main-header">
        <div>
          <span class="eyebrow">Inventario</span>
          <h2>Números de Parte</h2>
        </div>
      </div>
      <div class="card">
        <div class="search-row">
          <input type="search" id="cataSearch" placeholder="Filtrar por número de parte...">
        </div>
        <div style="overflow-x:auto;">
          <table>
            <thead><tr><th>N° de Parte</th><th class="col-center">Sobremedida</th><th class="col-center">Cantidad en Almacén</th><th id="cataAccionesHeader" style="display:none;">Acciones</th></tr></thead>
            <tbody id="cataTableBody"></tbody>
          </table>
        </div>
        <div id="cataEmpty" class="empty-state" style="display:none;">Aún no hay números de parte registrados. Se agregan automáticamente al hacer una entrada o salida.</div>
      </div>
    </section>

    <!-- ===== MODULO ENTRADA ===== -->
    <section id="module-entrada" class="module" style="display:none;">
      <div class="main-header">
        <div>
          <span class="eyebrow">Producción</span>
          <h2>Entrada de Material</h2>
        </div>
      </div>
      <div class="card">
        <h3>Registrar Entrada</h3>
        <form id="entradaForm">
          <div class="grid-form">
            <div class="field">
              <label>Número de Parte</label>
              <div class="input-prefix-group">
                <span class="input-prefix">EPV-</span>
                <input type="text" id="entParteSuffix" list="dl-partes-suffix" placeholder="1001" autocomplete="off" required>
              </div>
            </div>
            <div class="field">
              <label>Cantidad</label>
              <input type="number" id="entCantidad" min="0" step="1" placeholder="0" required>
            </div>
            <div class="field">
              <label>Sobremedida</label>
              <select id="entSobremedida"></select>
            </div>
            <div class="field">
              <label>Fecha</label>

    <!-- ===== MODULO GRAFICAS ===== -->
    <section id="module-graficas" class="module" style="display:none;">
      <div class="main-header">
        <div>
          <span class="eyebrow">Análisis</span>
          <h2>Gráficas de Movimiento</h2>

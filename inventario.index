</div>

<!-- ===== MODAL CONFIRMAR ELIMINAR ===== -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal">
    <h3 id="confirmTitle">¿Eliminar registro?</h3>
    <p id="confirmText" style="font-size:13.5px; color:var(--steel-500);">Esta acción no se puede deshacer.</p>
    <div class="modal-actions">
      <button type="button" class="btn btn-secondary" id="confirmCancelBtn">Cancelar</button>
      <button type="button" class="btn" id="confirmOkBtn" style="background:var(--red); color:white;">Eliminar</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* =================== ESTADO Y CONSTANTES =================== */
const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const SOBREMEDIDAS = ['STD','0.20','0.25','0.30','0.40','0.50','0.60','0.75','0.80','1.00'];
const ADMIN_CODE = '2208';

let state = { catalogo: [], entradas: [], salidas: [] };
let pendingDelete = null; // {type, id}
let usuarios = [];
let currentUser = null; // {nombre, password, rol}

/* =================== ALMACENAMIENTO LOCAL =================== */
// Los datos se guardan en el navegador donde se usa el sistema (localStorage),
// de forma inmediata y sin depender de internet. Si abres el archivo en OTRA
// computadora o navegador, ese equipo tendrá su propia copia de los datos.
const STORAGE_PREFIX = 'inv_aluminio_i_';
function loadAll(){
  state.catalogo = safeGetLocal('catalogo', []);
  state.entradas = safeGetLocal('entradas', []);
  state.salidas  = safeGetLocal('salidas', []);
}
function safeGetLocal(key, fallback){
  try{
    const raw = localStorage.getItem(STORAGE_PREFIX + key);
    return raw ? JSON.parse(raw) : fallback;
  }catch(e){ return fallback; }
}
function saveLocal(key, value){
  try{
    localStorage.setItem(STORAGE_PREFIX + key, JSON.stringify(value));
    return true;
  }catch(e){
    showToast('No se pudo guardar en este navegador (almacenamiento lleno o bloqueado).');
    return false;
  }
}
function saveCatalogo(){ saveLocal('catalogo', state.catalogo); }
function saveEntradas(){ saveLocal('entradas', state.entradas); }
function saveSalidas(){ saveLocal('salidas', state.salidas); }

/* =================== USUARIOS =================== */
function cargarUsuarios(){
  const guardados = safeGetLocal('usuarios', null);
  if(guardados && guardados.length){
    usuarios = guardados;
  }else{
    // Cuenta administradora inicial, para no perder el acceso original.
    usuarios = [{ nombre:'Manuel Fuentes', password:'1234', rol:'admin' }];
    saveLocal('usuarios', usuarios);
  }
}
function guardarUsuarios(){ saveLocal('usuarios', usuarios); }
cargarUsuarios();

/* =================== TEMAS DE COLOR =================== */
const TEMAS = {
  rojo:    { nombre:'Rojo (por defecto)', accent:'#e11b1b', accentDark:'#b01212' },
  azul:    { nombre:'Azul claro',          accent:'#38bdf8', accentDark:'#0ea5e9' },
  verde:   { nombre:'Verde',              accent:'#15803d', accentDark:'#14532d' },
  naranja: { nombre:'Naranja',            accent:'#ea580c', accentDark:'#c2410c' },
  morado:  { nombre:'Morado',             accent:'#7e22ce', accentDark:'#581c87' }
};
function aplicarTema(clave){
  const t = TEMAS[clave] || TEMAS.rojo;
  document.documentElement.style.setProperty('--accent', t.accent);
  document.documentElement.style.setProperty('--accent-dark', t.accentDark);
  document.querySelectorAll('.theme-swatch').forEach(sw=>{
    sw.classList.toggle('selected', sw.dataset.tema === clave);
  });
}
function renderThemeSwatches(){
  const cont = document.getElementById('themeSwatches');
  cont.innerHTML = Object.entries(TEMAS).map(([clave, t])=>`
    <div class="theme-swatch" data-tema="${clave}" style="background:${t.accent};" title="${t.nombre}" onclick="elegirTema('${clave}')"></div>
  `).join('');
}
window.elegirTema = function(clave){
  if(!currentUser) return;
  currentUser.tema = clave;
  guardarUsuarios();
  aplicarTema(clave);
  showToast('Apariencia actualizada');
};
renderThemeSwatches();

function genId(){ return 'id_' + Date.now() + '_' + Math.random().toString(36).slice(2,8); }
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(showToast._tm);
  showToast._tm = setTimeout(()=>t.classList.remove('show'), 2400);
}
function asegurarParteEnCatalogo(numero){
  const existe = state.catalogo.some(p=>p.numero.toLowerCase() === numero.toLowerCase());
  if(!existe){
    state.catalogo.push({ numero: numero.trim() });
    renderCatalogo();
    renderDatalist();
    saveCatalogo();
  }
}
function fechaDMY(iso){
  const [y,m,d] = iso.split('-');
  return `${d}/${m}/${y}`;
}
function todayISO(){
  const d = new Date();
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}

/* =================== LOGIN / REGISTRO =================== */
let perfilSeleccionado = null;

function entrarAlSistema(){
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').classList.add('active');
  loadAll();
  initAppData();
  renderAll();
  aplicarPermisosRol();
}

function renderPerfiles(){
  const cont = document.getElementById('profileGrid');
  const tarjetasUsuarios = usuarios.map(u=>`
    <div class="profile-card" onclick="seleccionarPerfil('${escapeHtml(u.nombre)}')">
      <button type="button" class="profile-delete-btn" title="Eliminar cuenta" onclick="eliminarPerfilClick(event, '${escapeHtml(u.nombre)}')">×</button>
      <div class="profile-avatar">${escapeHtml(u.nombre.trim().charAt(0).toUpperCase() || '?')}</div>
      <div class="profile-name">${escapeHtml(u.nombre)}</div>
      <div class="profile-role">${u.rol === 'admin' ? 'Administrador' : 'Usuario Normal'}</div>
    </div>`).join('');
  const tarjetaNueva = `
    <div class="profile-card profile-card-new" onclick="mostrarFormularioRegistro()">
      <div class="profile-avatar profile-avatar-new">+</div>
      <div class="profile-name">Nueva Cuenta</div>
      <div class="profile-role">Crear</div>
    </div>`;
  cont.innerHTML = tarjetasUsuarios + tarjetaNueva;
}

window.eliminarPerfilClick = function(e, nombre){
  e.stopPropagation();
  if(usuarios.length <= 1){
    showToast('Debe existir al menos una cuenta en el sistema');
    return;
  }
  confirmDelete('perfil', nombre);
};

window.seleccionarPerfil = function(nombre){
  const user = usuarios.find(u=>u.nombre === nombre);
  if(!user) return;
  perfilSeleccionado = user;
  document.getElementById('profileSelectWrap').style.display = 'none';
  document.getElementById('registerFormWrap').style.display = 'none';
  document.getElementById('passwordFormWrap').style.display = 'block';
  document.getElementById('passwordFormName').textContent = user.nombre;
  document.getElementById('passwordFormAvatar').textContent = user.nombre.trim().charAt(0).toUpperCase() || '?';
  document.getElementById('loginError').style.display = 'none';
  document.getElementById('loginPass').value = '';
  document.getElementById('loginPass').focus();
};

document.getElementById('backToProfilesLink').addEventListener('click', (e)=>{
  e.preventDefault();
  perfilSeleccionado = null;
  document.getElementById('passwordFormWrap').style.display = 'none';
  document.getElementById('profileSelectWrap').style.display = 'block';
});

document.getElementById('loginForm').addEventListener('submit', (e)=>{
  e.preventDefault();
  if(!perfilSeleccionado) return;
  const pass = document.getElementById('loginPass').value;
  const err = document.getElementById('loginError');
  if(pass === perfilSeleccionado.password){
    err.style.display = 'none';
    currentUser = perfilSeleccionado;
    entrarAlSistema();
  }else{
    err.style.display = 'block';
  }
});

document.getElementById('logoutBtn').addEventListener('click', ()=>{
  currentUser = null;
  perfilSeleccionado = null;
  document.getElementById('app').classList.remove('active');
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('loginPass').value = '';
  document.getElementById('loginError').style.display = 'none';
  mostrarPantallaPerfiles();
});

/* ---- alternar entre las 3 vistas del login ---- */
function mostrarPantallaPerfiles(){
  renderPerfiles();
  document.getElementById('profileSelectWrap').style.display = 'block';
  document.getElementById('passwordFormWrap').style.display = 'none';
  document.getElementById('registerFormWrap').style.display = 'none';
}
function mostrarFormularioRegistro(){
  document.getElementById('profileSelectWrap').style.display = 'none';
  document.getElementById('passwordFormWrap').style.display = 'none';
  document.getElementById('registerFormWrap').style.display = 'block';
}
document.getElementById('showLoginLink').addEventListener('click', (e)=>{ e.preventDefault(); mostrarPantallaPerfiles(); });

/* ---- mostrar/ocultar el campo de clave de administrador ---- */
document.querySelectorAll('input[name="regRole"]').forEach(radio=>{
  radio.addEventListener('change', ()=>{
    const esAdmin = document.querySelector('input[name="regRole"]:checked').value === 'admin';
    document.getElementById('regAdminCodeField').style.display = esAdmin ? 'block' : 'none';
  });
});

/* ---- crear cuenta ---- */
document.getElementById('registerForm').addEventListener('submit', (e)=>{
  e.preventDefault();
  const nombre = document.getElementById('regNombre').value.trim();
  const password = document.getElementById('regPassword').value;
  const rolSeleccionado = document.querySelector('input[name="regRole"]:checked').value;
  const err = document.getElementById('registerError');

  if(!nombre || !password) return;

  if(usuarios.some(u=>u.nombre.toLowerCase() === nombre.toLowerCase())){
    err.textContent = 'Ya existe una cuenta con ese nombre. Elige otro.';
    err.style.display = 'block';
    return;
  }

  let rolFinal = 'normal';
  if(rolSeleccionado === 'admin'){
    const clave = document.getElementById('regAdminCode').value;
    if(clave !== ADMIN_CODE){
      err.textContent = 'La clave de administrador es incorrecta.';
      err.style.display = 'block';
      return;
    }
    rolFinal = 'admin';
  }

  err.style.display = 'none';
  const nuevoUsuario = { nombre, password, rol: rolFinal };
  usuarios.push(nuevoUsuario);
  guardarUsuarios();
  currentUser = nuevoUsuario;
  showToast('Cuenta creada correctamente');
  e.target.reset();
  document.getElementById('regAdminCodeField').style.display = 'none';
  entrarAlSistema();
});

/* ---- aplicar permisos según el rol ---- */
function aplicarPermisosRol(){
  document.getElementById('sidebarUserName').textContent = currentUser.nombre;
  document.getElementById('sidebarUserRole').textContent = currentUser.rol === 'admin' ? 'Administrador' : 'Usuario Normal';
  document.getElementById('topbarUserName').textContent = currentUser.nombre;
  document.getElementById('topbarUserAvatar').textContent = currentUser.nombre.trim().charAt(0).toUpperCase() || '?';

  const esAdmin = currentUser.rol === 'admin';
  const MODULOS_PARA_TODOS = ['catalogo', 'reportes'];
  document.querySelectorAll('.nav-item').forEach(item=>{
    item.style.display = (esAdmin || MODULOS_PARA_TODOS.includes(item.dataset.module)) ? 'flex' : 'none';
  });

  document.querySelectorAll('.nav-item').forEach(i=>i.classList.remove('active'));
  document.querySelectorAll('.module').forEach(m=>m.style.display='none');
  const navInicial = document.querySelector('.nav-item[data-module="catalogo"]');
  if(navInicial) navInicial.classList.add('active');
  document.getElementById('module-catalogo').style.display = 'block';

  aplicarTema(currentUser.tema || 'rojo');
  renderCatalogo(); // refresca la columna "Acciones" según el rol
}

// Mostrar la lista de perfiles apenas carga la página (antes de iniciar sesión).
renderPerfiles();

/* =================== NAVEGACION =================== */
document.querySelectorAll('.nav-item').forEach(item=>{
  item.addEventListener('click', ()=>{
    document.querySelectorAll('.nav-item').forEach(i=>i.classList.remove('active'));
    item.classList.add('active');
    document.querySelectorAll('.module').forEach(m=>m.style.display='none');
    document.getElementById('module-' + item.dataset.module).style.display = 'block';
  });
});

/* =================== INIT DE SELECTS/FECHAS =================== */
function initAppData(){
  document.getElementById('entFecha').value = todayISO();
  document.getElementById('salFecha').value = todayISO();

  const sobOptions = SOBREMEDIDAS.map(s=>`<option value="${s}">${s}</option>`).join('');
  document.getElementById('entSobremedida').innerHTML = sobOptions;
  document.getElementById('salSobremedida').innerHTML = sobOptions;
  document.getElementById('movSobremedida').innerHTML = sobOptions;

  const mesSel = document.getElementById('repMes');
  MESES.forEach((m,i)=>{
    const o = document.createElement('option');
    o.value = i+1; o.textContent = m;
    mesSel.appendChild(o);
  });

  popularAnios();
}
function anosDisponibles(){
  const set = new Set();
  const now = new Date().getFullYear();
  set.add(now);
  [...state.entradas, ...state.salidas].forEach(r=>set.add(Number(r.anio)));
  return Array.from(set).sort((a,b)=>b-a);
}
function popularAnios(){
  const anios = anosDisponibles(); // descendente
  const repSel = document.getElementById('repAnio');
  const valorPrevio = repSel.value;
  repSel.innerHTML = '<option value="">Todos</option>' + anios.map(a=>`<option value="${a}">${a}</option>`).join('');
  if(anios.map(String).includes(valorPrevio)) repSel.value = valorPrevio;

  const anioAsc = anios.slice().sort((a,b)=>a-b);
  const graDesdeSel = document.getElementById('graAnioDesde');
  const graHastaSel = document.getElementById('graAnioHasta');
  const prevDesde = graDesdeSel.value, prevHasta = graHastaSel.value;
  const opciones = anioAsc.map(a=>`<option value="${a}">${a}</option>`).join('');
  graDesdeSel.innerHTML = opciones;
  graHastaSel.innerHTML = opciones;
  graDesdeSel.value = anioAsc.map(String).includes(prevDesde) ? prevDesde : anioAsc[0];
  graHastaSel.value = anioAsc.map(String).includes(prevHasta) ? prevHasta : anioAsc[anioAsc.length-1];
}

/* =================== RENDER GLOBAL =================== */
function renderAll(){
  renderDatalist();
  renderEntradas();
  renderSalidas();
  renderCatalogo();
  popularAnios();
}
function renderDatalist(){
  const dl = document.getElementById('dl-partes');
  const dlSufijo = document.getElementById('dl-partes-suffix');
  const ordenados = state.catalogo.slice().sort((a,b)=>a.numero.localeCompare(b.numero));
  dl.innerHTML = ordenados.map(p=>`<option value="${escapeHtml(p.numero)}"></option>`).join('');
  dlSufijo.innerHTML = ordenados.map(p=>{
    const sufijo = p.numero.toUpperCase().startsWith('EPV-') ? p.numero.slice(4) : p.numero;
    return `<option value="${escapeHtml(sufijo)}"></option>`;
  }).join('');
}
function numeroConPrefijo(sufijo){
  const limpio = sufijo.trim();
  return limpio.toUpperCase().startsWith('EPV-') ? limpio : 'EPV-' + limpio;
}
function sufijoDeNumero(numero){
  return numero.toUpperCase().startsWith('EPV-') ? numero.slice(4) : numero;
}
function escapeHtml(s){
  return String(s).replace(/[&<>"']/g, c=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
}

/* =================== ENTRADA =================== */
document.getElementById('entradaForm').addEventListener('submit', (e)=>{
  e.preventDefault();
  const sufijo = document.getElementById('entParteSuffix').value.trim();
  const cantidad = document.getElementById('entCantidad').value;
  const sobremedida = document.getElementById('entSobremedida').value;
  const fecha = document.getElementById('entFecha').value;
  const observacion = document.getElementById('entObservacion').value.trim();
  if(!sufijo || cantidad === '' || !fecha) return;
  const numero = numeroConPrefijo(sufijo);
  const [anio,mes,dia] = fecha.split('-');

  asegurarParteEnCatalogo(numero);
  state.entradas.push({
    id: genId(), numeroParte: numero, cantidad: Number(cantidad),
    sobremedida: sobremedida || 'STD', observacion,
    dia: Number(dia), mes: Number(mes), anio: Number(anio)
  });
  renderEntradas();
  renderCatalogo();
  popularAnios();
  showToast('Entrada registrada');
  e.target.reset();
  document.getElementById('entFecha').value = todayISO();
  document.getElementById('entSobremedida').value = 'STD';
  saveEntradas();
});

function renderEntradas(){
  const filtro = (document.getElementById('entSearch').value || '').toLowerCase();
  const tbody = document.getElementById('entTableBody');
  const rows = state.entradas
    .filter(r => r.numeroParte.toLowerCase().includes(filtro))
    .sort((a,b)=> (b.anio-a.anio) || (b.mes-a.mes) || (b.dia-a.dia));
  tbody.innerHTML = rows.map(r=>`
    <tr>
      <td class="mono">${String(r.dia).padStart(2,'0')}/${String(r.mes).padStart(2,'0')}/${r.anio}</td>
      <td class="mono">${escapeHtml(r.numeroParte)}</td>
      <td class="col-center">${r.cantidad}</td>
      <td class="col-center">${r.sobremedida}</td>
      <td>${escapeHtml(r.observacion || '—')}</td>
      <td class="row-actions">
        <button class="btn btn-ghost-outline" onclick="abrirEditarMovimiento('entrada','${r.id}')">Editar</button>
        <button class="btn btn-danger-outline" onclick="confirmDelete('entrada','${r.id}')">Eliminar</button>
      </td>
    </tr>`).join('');
  document.getElementById('entEmpty').style.display = rows.length ? 'none' : 'block';
}
document.getElementById('entSearch').addEventListener('input', renderEntradas);

/* =================== SALIDA =================== */
document.getElementById('salidaForm').addEventListener('submit', (e)=>{
  e.preventDefault();
  const sufijo = document.getElementById('salParteSuffix').value.trim();
  const cantidad = document.getElementById('salCantidad').value;
  const sobremedida = document.getElementById('salSobremedida').value;
  const fecha = document.getElementById('salFecha').value;
  const observacion = document.getElementById('salObservacion').value.trim();
  if(!sufijo || cantidad === '' || !fecha) return;
  const numero = numeroConPrefijo(sufijo);
  const [anio,mes,dia] = fecha.split('-');

  asegurarParteEnCatalogo(numero);
  state.salidas.push({
    id: genId(), numeroParte: numero, cantidad: Number(cantidad),
    sobremedida: sobremedida || 'STD', observacion,
    dia: Number(dia), mes: Number(mes), anio: Number(anio)
  });
  renderSalidas();
  renderCatalogo();
  popularAnios();
  showToast('Salida registrada');
  e.target.reset();
  document.getElementById('salFecha').value = todayISO();
  document.getElementById('salSobremedida').value = 'STD';
  saveSalidas();
});

function renderSalidas(){
  const filtro = (document.getElementById('salSearch').value || '').toLowerCase();
  const tbody = document.getElementById('salTableBody');
  const rows = state.salidas
    .filter(r => r.numeroParte.toLowerCase().includes(filtro))
    .sort((a,b)=> (b.anio-a.anio) || (b.mes-a.mes) || (b.dia-a.dia));
  tbody.innerHTML = rows.map(r=>`
    <tr>
      <td class="mono">${String(r.dia).padStart(2,'0')}/${String(r.mes).padStart(2,'0')}/${r.anio}</td>
      <td class="mono">${escapeHtml(r.numeroParte)}</td>
      <td class="col-center">${r.cantidad}</td>
      <td class="col-center">${r.sobremedida}</td>
      <td>${escapeHtml(r.observacion || '—')}</td>
      <td class="row-actions">
        <button class="btn btn-ghost-outline" onclick="abrirEditarMovimiento('salida','${r.id}')">Editar</button>
        <button class="btn btn-danger-outline" onclick="confirmDelete('salida','${r.id}')">Eliminar</button>
      </td>
    </tr>`).join('');
  document.getElementById('salEmpty').style.display = rows.length ? 'none' : 'block';
}
document.getElementById('salSearch').addEventListener('input', renderSalidas);

/* =================== REPORTES =================== */
let ultimoReporte = [];
document.getElementById('repBuscarBtn').addEventListener('click', ()=>{
  const sufijo = document.getElementById('repParteSuffix').value.trim();
  const numero = sufijo ? numeroConPrefijo(sufijo).toLowerCase() : '';
  const mes = document.getElementById('repMes').value;
  const anio = document.getElementById('repAnio').value;

  const combinados = [
    ...state.entradas.map(r=>({...r, tipo:'Entrada'})),
    ...state.salidas.map(r=>({...r, tipo:'Salida'}))
  ].filter(r=>{
    if(numero && r.numeroParte.toLowerCase() !== numero) return false;
    if(mes && Number(r.mes) !== Number(mes)) return false;
    if(anio && Number(r.anio) !== Number(anio)) return false;
    return true;
  }).sort((a,b)=> (b.anio-a.anio) || (b.mes-a.mes) || (b.dia-a.dia));

  ultimoReporte = combinados;
  const tbody = document.getElementById('repTableBody');
  tbody.innerHTML = combinados.map(r=>`
    <tr>
      <td class="mono">${String(r.dia).padStart(2,'0')}/${String(r.mes).padStart(2,'0')}/${r.anio}</td>
      <td><span class="tag ${r.tipo==='Entrada'?'tag-entrada':'tag-salida'}">${r.tipo}</span></td>
      <td class="mono">${escapeHtml(r.numeroParte)}</td>
      <td class="col-center">${r.cantidad}</td>
      <td class="col-center">${r.sobremedida}</td>
      <td>${escapeHtml(r.observacion || '—')}</td>
    </tr>`).join('');

  document.getElementById('repEmpty').style.display = combinados.length ? 'none' : 'block';
  if(combinados.length){
    document.getElementById('repEmpty').textContent = 'No se encontraron movimientos con esos filtros.';
  }

  const totalEnt = combinados.filter(r=>r.tipo==='Entrada').reduce((s,r)=>s+r.cantidad,0);
  const totalSal = combinados.filter(r=>r.tipo==='Salida').reduce((s,r)=>s+r.cantidad,0);
  document.getElementById('kpiEntradas').textContent = totalEnt;
  document.getElementById('kpiSalidas').textContent = totalSal;
  document.getElementById('kpiSaldo').textContent = totalEnt - totalSal;
  document.getElementById('repKpis').style.display = combinados.length ? 'grid' : 'none';
});

document.getElementById('exportExcelBtn').addEventListener('click', ()=>{
  if(!ultimoReporte.length){ showToast('No hay datos para exportar. Realiza una búsqueda primero.'); return; }
  const datos = ultimoReporte.map(r=>({
    'Fecha': `${String(r.dia).padStart(2,'0')}/${String(r.mes).padStart(2,'0')}/${r.anio}`,
    'Tipo': r.tipo,
    'Número de Parte': r.numeroParte,
    'Cantidad': r.cantidad,
    'Sobremedida': r.sobremedida,
    'Observación': r.observacion || ''
  }));
  const ws = XLSX.utils.json_to_sheet(datos);
  ws['!cols'] = [{wch:12},{wch:10},{wch:16},{wch:10},{wch:12},{wch:30}];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Reporte');
  const sufijoExport = document.getElementById('repParteSuffix').value.trim();
  const numero = sufijoExport ? numeroConPrefijo(sufijoExport) : 'todos';
  const mes = document.getElementById('repMes').value ? MESES[document.getElementById('repMes').value-1] : 'todos';
  const anio = document.getElementById('repAnio').value || 'todos';
  XLSX.writeFile(wb, `reporte_${numero}_${mes}_${anio}.xlsx`);
  showToast('Excel exportado');
});

document.getElementById('repLimpiarBtn').addEventListener('click', ()=>{
  document.getElementById('repParteSuffix').value = '';
  document.getElementById('repMes').value = '';
  document.getElementById('repAnio').value = '';
  document.getElementById('repTableBody').innerHTML = '';
  document.getElementById('repKpis').style.display = 'none';
  document.getElementById('repEmpty').style.display = 'block';
  document.getElementById('repEmpty').textContent = 'Usa los filtros y presiona "Buscar" para ver los movimientos.';
  ultimoReporte = [];
  showToast('Reporte limpiado');
});

/* =================== GRAFICAS =================== */
let movChartInstance = null;
document.getElementById('graBuscarBtn').addEventListener('click', ()=>{
  const sufijo = document.getElementById('graParteSuffix').value.trim();
  if(!sufijo){ showToast('Escribe un número de parte'); return; }
  const numeroCompleto = numeroConPrefijo(sufijo);
  const numero = numeroCompleto.toLowerCase();
  const anioDesde = Number(document.getElementById('graAnioDesde').value);
  const anioHasta = Number(document.getElementById('graAnioHasta').value);
  const msg = document.getElementById('chartMsg');
  const kpis = document.getElementById('graKpis');

  if(anioDesde > anioHasta){ showToast('El año "desde" no puede ser mayor al año "hasta"'); return; }

  const totalesEntrada = new Array(12).fill(0);
  const totalesSalida = new Array(12).fill(0);

  state.entradas.forEach(r=>{
    if(r.numeroParte.toLowerCase() === numero && r.anio >= anioDesde && r.anio <= anioHasta){
      totalesEntrada[r.mes-1] += r.cantidad;
    }
  });
  state.salidas.forEach(r=>{
    if(r.numeroParte.toLowerCase() === numero && r.anio >= anioDesde && r.anio <= anioHasta){
      totalesSalida[r.mes-1] += r.cantidad;
    }
  });

  const hayDatos = totalesEntrada.some(v=>v>0) || totalesSalida.some(v=>v>0);

  const canvas = document.getElementById('movChart');
  if(typeof Chart === 'undefined'){
    showToast('No se pudo cargar la librería de gráficas. Revisa tu conexión a internet.');
    return;
  }
  const ctx = canvas.getContext('2d');
  if(movChartInstance) movChartInstance.destroy();
  movChartInstance = new Chart(ctx, {
    type:'bar',
    data:{
      labels: MESES.map(m=>m.slice(0,3)),
      datasets:[
        { label:'Entradas', data: totalesEntrada, backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--graphite-900').trim(), borderRadius:4 },
        { label:'Salidas', data: totalesSalida, backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--accent').trim(), borderRadius:4 }
      ]
    },
    options:{
      responsive:true,
      plugins:{ legend:{ display:true, position:'bottom' } },
      scales:{ y:{ beginAtZero:true, ticks:{ precision:0 } } }
    }
  });

  if(hayDatos){
    const totalesMov = totalesEntrada.map((v,i)=>v + totalesSalida[i]);
    const idxMov = totalesMov.indexOf(Math.max(...totalesMov));
    const idxEnt = totalesEntrada.indexOf(Math.max(...totalesEntrada));
    const idxSal = totalesSalida.indexOf(Math.max(...totalesSalida));

    document.getElementById('kpiMesMovimiento').textContent = `${MESES[idxMov]} (${totalesMov[idxMov]})`;
    document.getElementById('kpiMesEntrada').textContent = totalesEntrada[idxEnt] > 0 ? `${MESES[idxEnt]} (${totalesEntrada[idxEnt]})` : '—';
    document.getElementById('kpiMesSalida').textContent = totalesSalida[idxSal] > 0 ? `${MESES[idxSal]} (${totalesSalida[idxSal]})` : '—';
    kpis.style.display = 'grid';

    msg.style.display = 'block';
    const rango = anioDesde === anioHasta ? `${anioDesde}` : `${anioDesde}–${anioHasta}`;
    msg.innerHTML = `Para <strong class="mono">${escapeHtml(numeroCompleto)}</strong> en el periodo ${rango}, el mes con más movimiento total fue <strong>${MESES[idxMov]}</strong> con <strong>${totalesMov[idxMov]}</strong> piezas (${totalesEntrada[idxMov]} entradas + ${totalesSalida[idxMov]} salidas).`;

    const tbody = document.getElementById('graTablaBody');
    const totalEntGeneral = totalesEntrada.reduce((a,b)=>a+b,0);
    const totalSalGeneral = totalesSalida.reduce((a,b)=>a+b,0);
    tbody.innerHTML = MESES.map((nombreMes,i)=>`
      <tr${i===idxMov ? ' style="background:#fff5f5;"' : ''}>
        <td>${nombreMes}</td>
        <td>${totalesEntrada[i]}</td>
        <td>${totalesSalida[i]}</td>
        <td><strong>${totalesMov[i]}</strong></td>
      </tr>`).join('') + `
      <tr style="background:var(--graphite-900); color:white; font-weight:700;">
        <td>Total del periodo</td>
        <td>${totalEntGeneral}</td>
        <td>${totalSalGeneral}</td>
        <td>${totalEntGeneral + totalSalGeneral}</td>
      </tr>`;
    document.getElementById('graTablaCard').style.display = 'block';
  }else{
    kpis.style.display = 'none';
    document.getElementById('graTablaCard').style.display = 'none';
    msg.style.display = 'block';
    msg.innerHTML = `No se encontraron movimientos de <strong class="mono">${escapeHtml(numeroCompleto)}</strong> en el periodo seleccionado.`;
  }
});

document.getElementById('graLimpiarBtn').addEventListener('click', ()=>{
  document.getElementById('graParteSuffix').value = '';
  popularAnios();
  document.getElementById('graKpis').style.display = 'none';
  document.getElementById('graTablaCard').style.display = 'none';
  document.getElementById('chartMsg').style.display = 'none';
  document.getElementById('chartMsg').innerHTML = '';
  if(movChartInstance){ movChartInstance.destroy(); movChartInstance = null; }
  showToast('Gráfica limpiada');
});

/* =================== NUMEROS DE PARTE (inventario, solo lectura) =================== */
function calcularInventario(){
  const mapa = {};
  state.entradas.forEach(r=>{
    const key = r.numeroParte + '|' + r.sobremedida;
    if(!mapa[key]) mapa[key] = { numeroParte:r.numeroParte, sobremedida:r.sobremedida, cantidad:0 };
    mapa[key].cantidad += r.cantidad;
  });
  state.salidas.forEach(r=>{
    const key = r.numeroParte + '|' + r.sobremedida;
    if(!mapa[key]) mapa[key] = { numeroParte:r.numeroParte, sobremedida:r.sobremedida, cantidad:0 };
    mapa[key].cantidad -= r.cantidad;
  });
  return Object.values(mapa).sort((a,b)=> a.numeroParte.localeCompare(b.numeroParte) || a.sobremedida.localeCompare(b.sobremedida));
}

function renderCatalogo(){
  const filtro = (document.getElementById('cataSearch').value || '').toLowerCase();
  const tbody = document.getElementById('cataTableBody');
  // Tanto admins como usuarios normales pueden CONSULTAR los movimientos (solo lectura).
  // Ningún rol puede modificar nada desde esta lista.
  const puedeVerMovimientos = !!currentUser;
  document.getElementById('cataAccionesHeader').style.display = puedeVerMovimientos ? 'table-cell' : 'none';

  const inventario = calcularInventario().filter(it => it.numeroParte.toLowerCase().includes(filtro));

  tbody.innerHTML = inventario.map(it=>`
    <tr>
      <td class="mono">${escapeHtml(it.numeroParte)}</td>
      <td class="col-center">${escapeHtml(it.sobremedida)}</td>
      <td class="col-center">${it.cantidad}</td>
      ${puedeVerMovimientos ? `<td class="row-actions"><button class="btn btn-ghost-outline" onclick="abrirVerMovimientos('${escapeHtml(it.numeroParte)}','${escapeHtml(it.sobremedida)}')">Ver Movimientos</button></td>` : ''}
    </tr>`).join('');
  document.getElementById('cataEmpty').style.display = inventario.length ? 'none' : 'block';
}
document.getElementById('cataSearch').addEventListener('input', renderCatalogo);

/* ---- ver movimientos de un número de parte + sobremedida (solo admin) ---- */
window.abrirVerMovimientos = function(numeroParte, sobremedida){
  if(!currentUser) return;
  document.getElementById('verMovimientosTitle').textContent = `Movimientos de ${numeroParte} · Sobremedida ${sobremedida}`;

  const movimientos = [
    ...state.entradas.filter(r=>r.numeroParte===numeroParte && r.sobremedida===sobremedida).map(r=>({...r, tipo:'Entrada'})),
    ...state.salidas.filter(r=>r.numeroParte===numeroParte && r.sobremedida===sobremedida).map(r=>({...r, tipo:'Salida'}))
  ].sort((a,b)=> (b.anio-a.anio) || (b.mes-a.mes) || (b.dia-a.dia));

  const tbody = document.getElementById('verMovimientosBody');
  tbody.innerHTML = movimientos.map(r=>`
    <tr>
      <td class="mono">${String(r.dia).padStart(2,'0')}/${String(r.mes).padStart(2,'0')}/${r.anio}</td>
      <td><span class="tag ${r.tipo==='Entrada'?'tag-entrada':'tag-salida'}">${r.tipo}</span></td>
      <td class="col-center">${r.cantidad}</td>
      <td>${escapeHtml(r.observacion || '—')}</td>
    </tr>`).join('');
  document.getElementById('verMovimientosEmpty').style.display = movimientos.length ? 'none' : 'block';
  document.getElementById('verMovimientosModal').classList.add('active');
};
document.getElementById('verMovimientosCerrarBtn').addEventListener('click', ()=>{
  document.getElementById('verMovimientosModal').classList.remove('active');
});

/* =================== EDITAR MOVIMIENTO (entrada/salida) =================== */
window.abrirEditarMovimiento = function(tipo, id){
  const lista = tipo === 'entrada' ? state.entradas : state.salidas;
  const r = lista.find(x=>x.id === id);
  if(!r) return;
  document.getElementById('movModalTitle').textContent = tipo === 'entrada' ? 'Editar entrada' : 'Editar salida';
  document.getElementById('movTipo').value = tipo;
  document.getElementById('movId').value = id;
  document.getElementById('movParteSuffix').value = sufijoDeNumero(r.numeroParte);
  document.getElementById('movCantidad').value = r.cantidad;
  document.getElementById('movSobremedida').value = r.sobremedida;
  document.getElementById('movFecha').value = `${r.anio}-${String(r.mes).padStart(2,'0')}-${String(r.dia).padStart(2,'0')}`;
  document.getElementById('movObservacion').value = r.observacion || '';
  document.getElementById('movModal').classList.add('active');
};
document.getElementById('movCancelBtn').addEventListener('click', ()=>{
  document.getElementById('movModal').classList.remove('active');
});
document.getElementById('movForm').addEventListener('submit', (e)=>{
  e.preventDefault();
  const tipo = document.getElementById('movTipo').value;
  const id = document.getElementById('movId').value;
  const sufijo = document.getElementById('movParteSuffix').value.trim();
  const cantidad = document.getElementById('movCantidad').value;
  const sobremedida = document.getElementById('movSobremedida').value;
  const fecha = document.getElementById('movFecha').value;
  const observacion = document.getElementById('movObservacion').value.trim();
  if(!sufijo || cantidad === '' || !fecha) return;
  const numero = numeroConPrefijo(sufijo);
  const [anio,mes,dia] = fecha.split('-');

  const lista = tipo === 'entrada' ? state.entradas : state.salidas;
  const r = lista.find(x=>x.id === id);
  if(!r) return;

  asegurarParteEnCatalogo(numero);
  r.numeroParte = numero;
  r.cantidad = Number(cantidad);
  r.sobremedida = sobremedida || 'STD';
  r.observacion = observacion;
  r.dia = Number(dia); r.mes = Number(mes); r.anio = Number(anio);

  if(tipo === 'entrada'){ renderEntradas(); saveEntradas(); }
  else{ renderSalidas(); saveSalidas(); }
  renderCatalogo();
  popularAnios();
  document.getElementById('movModal').classList.remove('active');
  showToast('Movimiento actualizado');
});

/* =================== ELIMINAR (con confirmación) =================== */
window.confirmDelete = function(type, id){
  pendingDelete = { type, id };
  const textos = {
    entrada: 'Se eliminará este movimiento de entrada.',
    salida: 'Se eliminará este movimiento de salida.',
    perfil: `Se eliminará la cuenta de "${id}". Esta acción no se puede deshacer.`
  };
  document.getElementById('confirmText').textContent = textos[type];
  document.getElementById('confirmModal').classList.add('active');
};
document.getElementById('confirmCancelBtn').addEventListener('click', ()=>{
  pendingDelete = null;
  document.getElementById('confirmModal').classList.remove('active');
});
document.getElementById('confirmOkBtn').addEventListener('click', ()=>{
  if(!pendingDelete) return;
  const { type, id } = pendingDelete;
  if(type === 'entrada'){
    state.entradas = state.entradas.filter(r=>r.id !== id);
    renderEntradas();
    renderCatalogo();
    saveEntradas();
  }else if(type === 'salida'){
    state.salidas = state.salidas.filter(r=>r.id !== id);
    renderSalidas();
    renderCatalogo();
    saveSalidas();
  }else if(type === 'perfil'){
    usuarios = usuarios.filter(u=>u.nombre !== id);
    guardarUsuarios();
    renderPerfiles();
  }
  pendingDelete = null;
  document.getElementById('confirmModal').classList.remove('active');
  showToast('Eliminado correctamente');
});

/* =================== MENU DE PERFIL (arriba a la derecha) =================== */
document.getElementById('topbarUserBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  const dd = document.getElementById('profileDropdown');
  const abriendo = !dd.classList.contains('active');
  dd.classList.toggle('active', abriendo);
  if(abriendo && currentUser){
    document.getElementById('perfilNombreInput').value = currentUser.nombre;
    document.getElementById('verCodigoSection').style.display = currentUser.rol === 'admin' ? 'block' : 'none';
  }
});
document.addEventListener('click', (e)=>{
  const dd = document.getElementById('profileDropdown');
  const wrap = document.getElementById('topbarUserBtn');
  if(dd.classList.contains('active') && !dd.contains(e.target) && e.target !== wrap && !wrap.contains(e.target)){
    dd.classList.remove('active');
  }
});

document.getElementById('perfilGuardarNombreBtn').addEventListener('click', ()=>{
  if(!currentUser) return;
  const nuevoNombre = document.getElementById('perfilNombreInput').value.trim();
  if(!nuevoNombre){ showToast('El nombre no puede quedar vacío'); return; }
  const existeOtro = usuarios.some(u => u !== currentUser && u.nombre.toLowerCase() === nuevoNombre.toLowerCase());
  if(existeOtro){ showToast('Ya existe otro usuario con ese nombre'); return; }
  currentUser.nombre = nuevoNombre;
  guardarUsuarios();
  document.getElementById('sidebarUserName').textContent = currentUser.nombre;
  document.getElementById('topbarUserName').textContent = currentUser.nombre;
  document.getElementById('topbarUserAvatar').textContent = currentUser.nombre.trim().charAt(0).toUpperCase() || '?';
  showToast('Nombre actualizado');
});

/* ---- ver código fuente (solo admin) ---- */
document.getElementById('verCodigoBtn').addEventListener('click', ()=>{
  if(!currentUser || currentUser.rol !== 'admin') return;
  const fuente = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
  document.getElementById('codigoFuenteTexto').textContent = fuente;
  document.getElementById('profileDropdown').classList.remove('active');
  document.getElementById('codigoModal').classList.add('active');
});
document.getElementById('codigoCerrarBtn').addEventListener('click', ()=>{
  document.getElementById('codigoModal').classList.remove('active');
});
document.getElementById('codigoDescargarBtn').addEventListener('click', ()=>{
  const texto = document.getElementById('codigoFuenteTexto').textContent;
  const blob = new Blob([texto], { type:'text/html' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'sistema_inventario_codigo_fuente.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
});

/* =================== IMPRESIÓN DE HOJAS DE REPORTE =================== */
function obtenerLogoDataUri(){
  const img = document.querySelector('.brand-panel-content img') || document.querySelector('.login-logo');
  return img ? img.src : '';
}
function construirEncabezadoImpresion(subtitulo){
  const ahora = new Date();
  const usuarioNombre = currentUser ? currentUser.nombre : 'Desconocido';
  return `
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
      <div>
        <h1 style="font-size:19px; margin:0; color:#111;">Manufacturas de Aluminio I C.A. - ${subtitulo}</h1>
        <p style="font-size:12px; color:#555; margin:6px 0 0;">Generado el ${escapeHtml(ahora.toLocaleDateString())} a las ${escapeHtml(ahora.toLocaleTimeString())} por <strong>${escapeHtml(usuarioNombre)}</strong></p>
      </div>
      <img src="${obtenerLogoDataUri()}" style="height:70px; width:auto; object-fit:contain; flex-shrink:0;">
    </div>`;
}
function abrirVentanaImpresion(tituloPagina, cuerpoHtml){
  const html = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${escapeHtml(tituloPagina)}</title><style>
    body{font-family:Arial,Helvetica,sans-serif; padding:28px; color:#111;}
    table{width:100%; border-collapse:collapse; margin-top:8px;}
    th,td{border:1px solid #ccc; padding:7px 10px; font-size:13px; text-align:left;}
    th{background:#111; color:#fff;}
    tr:nth-child(even) td{background:#f5f5f5;}
  </style></head><body>${cuerpoHtml}</body></html>`;
  const ventana = window.open('', '_blank');
  if(!ventana){ showToast('Permite las ventanas emergentes para poder imprimir el reporte'); return; }
  ventana.document.write(html);
  ventana.document.close();
  ventana.focus();
  ventana.print();
}

/* ---- Imprimir Reporte General (lista completa de Números de parte) ---- */
document.getElementById('imprimirReporteGeneralBtn').addEventListener('click', ()=>{
  const inventario = calcularInventario();
  const filasHtml = inventario.map(it=>`
    <tr><td>${escapeHtml(it.numeroParte)}</td><td>${escapeHtml(it.sobremedida)}</td><td>${it.cantidad}</td></tr>
  `).join('');
  const cuerpo = construirEncabezadoImpresion('Inventario General') + `
    <table><thead><tr><th>N&deg; de Parte</th><th>Sobremedida</th><th>Cantidad en Almac&eacute;n</th></tr></thead><tbody>${filasHtml}</tbody></table>`;
  abrirVentanaImpresion('Inventario General', cuerpo);
});

/* ---- Imprimir Reporte de Movimientos (resultado filtrado del módulo Reportes) ---- */
document.getElementById('imprimirReporteMovimientosBtn').addEventListener('click', ()=>{
  if(!ultimoReporte.length){ showToast('No hay datos para imprimir. Realiza una búsqueda primero.'); return; }
  const filasHtml = ultimoReporte.map(r=>`
    <tr>
      <td>${String(r.dia).padStart(2,'0')}/${String(r.mes).padStart(2,'0')}/${r.anio}</td>
      <td>${r.tipo}</td>
      <td>${escapeHtml(r.numeroParte)}</td>
      <td>${r.cantidad}</td>
      <td>${escapeHtml(r.sobremedida)}</td>
      <td>${escapeHtml(r.observacion || '—')}</td>
    </tr>`).join('');
  const totalEnt = ultimoReporte.filter(r=>r.tipo==='Entrada').reduce((s,r)=>s+r.cantidad,0);
  const totalSal = ultimoReporte.filter(r=>r.tipo==='Salida').reduce((s,r)=>s+r.cantidad,0);
  const cuerpo = construirEncabezadoImpresion('Reporte Movimientos de Inventario') + `
    <p style="font-size:13px; margin:0 0 12px;">
      Total entradas: <strong>${totalEnt}</strong> &nbsp;|&nbsp;
      Total salidas: <strong>${totalSal}</strong> &nbsp;|&nbsp;
      Saldo: <strong>${totalEnt - totalSal}</strong>
    </p>
    <table><thead><tr><th>Fecha</th><th>Tipo</th><th>N&deg; de Parte</th><th>Cantidad</th><th>Sobremedida</th><th>Observaci&oacute;n</th></tr></thead><tbody>${filasHtml}</tbody></table>`;
  abrirVentanaImpresion('Reporte Movimientos de Inventario', cuerpo);
});

</script>
</body>
</html>

<div class="modal-overlay" id="movModal">
  <div class="modal">
    <h3 id="movModalTitle">Editar movimiento</h3>
    <form id="movForm">
      <input type="hidden" id="movTipo">
      <input type="hidden" id="movId">
      <div class="field">

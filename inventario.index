      </div>
    </section>

    <!-- ===== MODULO SALIDA ===== -->
    <section id="module-salida" class="module" style="display:none;">
      <div class="main-header">
        <div>
          <span class="eyebrow">Almacén de producto terminado</span>
          <h2>Salida de Material</h2>
        </div>
      </div>
      <div class="card">
        <h3>Registrar Salida</h3>
        <form id="salidaForm">
          <div class="grid-form">
            <div class="field">
              <label>Número de Parte</label>
              <div class="input-prefix-group">
                <span class="input-prefix">EPV-</span>
                <input type="text" id="salParteSuffix" list="dl-partes-suffix" placeholder="1001" autocomplete="off" required>
              </div>
            </div>
            <div class="field">
              <label>Cantidad</label>
              <input type="number" id="salCantidad" min="0" step="1" placeholder="0" required>
            </div>
            <div class="field">
              <label>Sobremedida</label>
              <select id="salSobremedida"></select>
            </div>
            <div class="field">
              <label>Fecha</label>
              <input type="date" id="salFecha" required>
            </div>
          </div>
          <div class="field" style="margin-top:14px;">
            <label>Observación (Opcional)</label>
            <input type="text" id="salObservacion" placeholder="Ej. entrega parcial, cliente pidió urgencia...">
          </div>
          <div class="field" style="margin-top:14px;">
            <button type="submit" class="btn btn-blue" style="width:100%; max-width:220px;">Registrar Salida</button>
          </div>
        </form>
      </div>
      <div class="card">
        <h3>Movimientos de Salida</h3>
        <div class="search-row">
          <input type="search" id="salSearch" placeholder="Filtrar por número de parte o descripción...">
        </div>
        <div style="overflow-x:auto;">
          <table>
            <thead><tr><th>Fecha</th><th>N° de Parte</th><th class="col-center">Cantidad</th><th class="col-center">Sobremedida</th><th>Observación</th><th>Acciones</th></tr></thead>
            <tbody id="salTableBody"></tbody>
          </table>

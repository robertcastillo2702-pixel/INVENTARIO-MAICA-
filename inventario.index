        <div class="kpi saldo"><div class="eyebrow">Mes de mayor movimiento</div><div class="value" id="kpiMesMovimiento" style="font-size:19px;">—</div></div>
        <div class="kpi entrada"><div class="eyebrow">Mes con más entradas</div><div class="value" id="kpiMesEntrada" style="font-size:19px;">—</div></div>
        <div class="kpi salida"><div class="eyebrow">Mes con más salidas</div><div class="value" id="kpiMesSalida" style="font-size:19px;">—</div></div>
      </div>

      <div class="card">

            <button class="btn btn-secondary btn-sm" id="imprimirReporteMovimientosBtn">🖨 Imprimir</button>
            <button class="btn btn-secondary btn-sm" id="exportExcelBtn">⬇ Exportar a Excel</button>
          </span>

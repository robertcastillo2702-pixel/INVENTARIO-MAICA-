            <label>Observación (Opcional)</label>
            <input type="text" id="entObservacion" placeholder="Ej. material con rebaba, revisar tolerancia...">
          </div>
          <div class="field" style="margin-top:14px;">
            <button type="submit" class="btn btn-primary" style="width:100%; max-width:220px;">Registrar Entrada</button>
          </div>
        </form>
      </div>
      <div class="card">
        <h3>Movimientos de Entrada</h3>
        <div class="search-row">
          <input type="search" id="entSearch" placeholder="Filtrar por número de parte o descripción...">
        </div>
        <div style="overflow-x:auto;">
          <table>
            <thead><tr><th>Fecha</th><th>N° de Parte</th><th class="col-center">Cantidad</th><th class="col-center">Sobremedida</th><th>Observación</th><th>Acciones</th></tr></thead>
            <tbody id="entTableBody"></tbody>
          </table>
        </div>

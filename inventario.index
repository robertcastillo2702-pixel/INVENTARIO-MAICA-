        <div class="kpi salida"><div class="eyebrow">Total salidas</div><div class="value" id="kpiSalidas">0</div></div>
        <div class="kpi saldo"><div class="eyebrow">Saldo</div><div class="value" id="kpiSaldo">0</div></div>
      </div>

      <div class="card">
        <h3 style="display:flex; align-items:center; justify-content:space-between; border-bottom:none; padding-bottom:0; flex-wrap:wrap; gap:8px;">
